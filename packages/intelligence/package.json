{
  "name": "@oca/intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "requirements:evaluate": "node --import tsx src/requirements/evaluation/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oca/domain": "workspace:*",
    "@oca/schemas": "workspace:*",
    "@oca/database": "workspace:*",
    "@oca/sources": "workspace:*"
  },
  "devDependencies": {
    "@oca/config": "workspace:*",
    "typescript": "5.6.3",
    "vitest": "^2.1.2"
  }
}

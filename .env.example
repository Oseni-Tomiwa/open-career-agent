# Shared server configuration
APP_ENV=development
IDENTITY_MODE=development
TRUSTED_CANDIDATE_ID=development-candidate
MIGRATION_MODE=auto
SQLITE_DATABASE_PATH=./data/open-career-agent.sqlite

# API-only configuration
# Default-off, direct-loopback development setup only; never enable behind a proxy.
LOCAL_WORKSPACE_SETUP_ENABLED=false
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=168

# Browser-safe configuration. Only VITE_ variables enter the web bundle.
VITE_API_BASE_URL=http://localhost:3000
VITE_DEPLOYMENT_MODE=development
# Seed remains the default. Personal setup: use api + development and enable server setup.
VITE_PRODUCT_DATA_SOURCE=seed
# Optional compatibility assertion in development; it never selects the server identity.
# Required fixed identity for the separate self-hosted browser mode.
VITE_DEVELOPMENT_CANDIDATE_ID=

# Worker-only configuration
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000

# Shared server configuration
APP_ENV=development
SQLITE_DATABASE_PATH=./data/open-career-agent.sqlite

# API-only configuration
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Browser-safe configuration. Only VITE_ variables enter the web bundle.
VITE_API_BASE_URL=http://localhost:3000
# Seed remains the default. Set both values below to use real API projections.
VITE_PRODUCT_DATA_SOURCE=seed
VITE_DEVELOPMENT_CANDIDATE_ID=development-candidate

# Worker-only configuration
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000
